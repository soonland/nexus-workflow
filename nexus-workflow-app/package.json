{
  "name": "nexus-workflow-app",
  "version": "0.1.0",
  "description": "Host application for the nexus-workflow-core engine — HTTP API, PostgreSQL persistence, task worker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "db:reset": "tsx src/db/reset-cli.ts",
    "tenant:provision": "tsx src/db/provision-tenant-cli.ts",
    "operator:create": "tsx src/db/operator-create-cli.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "nexus-workflow-core": "workspace:*",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
