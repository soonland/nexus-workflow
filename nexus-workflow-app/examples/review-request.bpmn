<?xml version="1.0" encoding="UTF-8"?>
<!--
  review-request.bpmn: the smallest workflow that still shows the interesting parts.

  Start -> Review (a person decides) -> Decision (gateway) -> Approved | Rejected

  Try it:
    1. Deploy this file (Definitions -> Deploy definition).
    2. Start an instance with variables such as  {"title": "New laptop", "amount": 1200}
    3. Open Tasks, claim "Review the request" and complete it with output variables
         {"decision": "approved"}    -> ends at "Approved"
         anything else (or nothing)  -> ends at "Rejected" (the gateway's default flow)
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="review-request-definitions"
  targetNamespace="http://nexus-workflow/examples">

  <bpmn:process id="review-request" name="Review request" isExecutable="true">

    <bpmn:startEvent id="start" name="Request received">
      <bpmn:outgoing>flow_to_review</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="review" name="Review the request">
      <bpmn:incoming>flow_to_review</bpmn:incoming>
      <bpmn:outgoing>flow_to_decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="decision" name="Decision" default="flow_rejected">
      <bpmn:incoming>flow_to_decision</bpmn:incoming>
      <bpmn:outgoing>flow_approved</bpmn:outgoing>
      <bpmn:outgoing>flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="end_approved" name="Approved">
      <bpmn:incoming>flow_approved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_rejected" name="Rejected">
      <bpmn:incoming>flow_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_to_review" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_to_decision" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="flow_approved" name="approved" sourceRef="decision" targetRef="end_approved">
      <bpmn:conditionExpression>decision === 'approved'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rejected" name="otherwise" sourceRef="decision" targetRef="end_rejected" />

  </bpmn:process>
</bpmn:definitions>
