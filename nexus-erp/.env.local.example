# nexus-erp environment variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_erp"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3001"
WORKFLOW_API_URL="http://localhost:3000"
# The ERP is a tenant of the workflow engine. `pnpm init` creates the tenant and the key;
# to (re)create them by hand:
#   pnpm --filter nexus-workflow-app tenant:provision nexus-erp --name "Nexus ERP" \
#     --write-env ../nexus-erp/.env.local
WORKFLOW_TENANT_ID="nexus-erp"
# API key for the workflow API (sent as a Bearer token)
WORKFLOW_API_KEY=""
