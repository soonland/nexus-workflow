    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@swc/helpers": "^0.5.23",
    "bcryptjs": "^3.0.3",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.22.0",
    "dayjs": "^1.11.21",
